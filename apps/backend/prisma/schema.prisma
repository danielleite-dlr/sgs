  amount            Decimal  @db.Decimal(12, 2)
  paidAt            DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  memberId          String?  @map("member_id") @db.Uuid
  reversesPaymentId String?  @unique(map: "uq_cp_reverses") @map("reverses_payment_id") @db.Uuid
  note              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id])
  contract     Contract         @relation(fields: [contractId], references: [id])
  member       Member?          @relation("ContractPaymentMember", fields: [memberId], references: [id])
  reverses     ContractPayment? @relation("ContractPaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedBy   ContractPayment? @relation("ContractPaymentReversal")

  @@index([organizationId, paidAt], name: "ix_cp_org_paid")
  @@index([contractId], name: "ix_cp_contract")
  @@map("contract_payments")
}

model AiScheduleSuggestion {
  id             String   @id @default(dbgenerated("gen_uuid_v7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  inputHash      String   @map("input_hash") @db.Char(64)
  source         String   @db.VarChar(10)
  model          String?  @db.VarChar(60)
  proposal       Json     @db.JsonB
  warnings       Json     @default("[]") @db.JsonB
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [organizationId], references: [id])
  group           BridalGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByMember Member?      @relation("AiScheduleSuggestionCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId, groupId, inputHash, createdAt], name: "ix_ass_lookup")
  @@map("ai_schedule_suggestions")
}

model ContractAlertRun {
  organizationId String   @map("organization_id") @db.Uuid
  runDate        DateTime @map("run_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, runDate], name: "pk_contract_alert_runs")
  @@map("contract_alert_runs")
}
