# ─── SGS Environment Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=sgs_migrator
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sgs_dev
POSTGRES_PORT=5432

# ─── PgBouncer ────────────────────────────────────────────────────────────────
PGBOUNCER_PORT=5433
# NOTE: PgBouncer runs in transaction-mode. SET LOCAL for RLS is required.
# The app connects via PgBouncer (port 5433) using the sgs_app role.
# Prisma migrations use the direct connection (port 5432) with sgs_migrator role.

# ─── Database URLs ────────────────────────────────────────────────────────────
# App runtime — via PgBouncer (transaction mode), uses sgs_app role
DATABASE_URL=postgres://sgs_app:change_me_in_production@localhost:5433/sgs_dev
# Migrations — direct to PostgreSQL, uses sgs_migrator role (BYPASSRLS)
# Named DIRECT_URL to match Prisma schema directUrl = env("DIRECT_URL")
DIRECT_URL=postgres://sgs_migrator:change_me_in_production@localhost:5432/sgs_dev

# ─── Valkey / Redis ───────────────────────────────────────────────────────────
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379
# AOF persistence is enabled in docker-compose.yml (--appendonly yes)

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://localhost:7700
# IMPORTANT: Change this to a strong random key in production (min 16 chars)
MEILISEARCH_KEY=dev_master_key_change_in_prod
MEILI_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_min_32_chars_change_in_prod_XXXX
JWT_REFRESH_SECRET=dev_refresh_secret_min_32_chars_change_in_prod_XX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@sgs.app

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# ─── Backend ports ────────────────────────────────────────────────────────────
BACKEND_PORT=3000
