# ─── SGS — Staging (sgs.jessicaseixasmakeup.com.br) ──────────────────────────
# Copie para .env.staging e preencha. NUNCA versione .env.staging.
# Usado por: docker compose -f docker-compose.staging.yml --env-file .env.staging
#
# Gere cada segredo com:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=sgs_migrator
POSTGRES_PASSWORD=
POSTGRES_DB=sgs_staging
# Senha da role de runtime (sgs_app, sujeita a RLS). Aplicada na criação do
# volume por infra/postgres/init-staging/01-create-roles.sh.
SGS_APP_PASSWORD=

# NOTA: o backend conecta direto em postgres:5432 como sgs_app, espelhando o
# docker-compose.yml de dev — RLS ativa. O PgBouncer sobe junto mas ainda não
# está no caminho do app: com AUTH_TYPE=trust ele conectaria ao Postgres com as
# credenciais do sgs_migrator (BYPASSRLS), o que anularia o isolamento por
# tenant. Colocar o app atrás do pooler exige AUTH_TYPE/userlist adequados.

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_KEY=
MEILI_LOG_LEVEL=INFO

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sem chave, o backend sobe mas não envia e-mail. Preencha quando for validar
# fluxos de convite/recuperação de senha.
RESEND_API_KEY=
EMAIL_FROM=noreply@jessicaseixasmakeup.com.br

# Enquanto não houver disparo de e-mail: conta nasce verificada e o signup já
# devolve sessão, sem passar pela tela de verificação. Volte para false assim
# que o Resend estiver configurado. NUNCA usar true em produção.
AUTH_SKIP_EMAIL_VERIFICATION=true

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://sgs.jessicaseixasmakeup.com.br

# ─── Portas no host (sempre em 127.0.0.1, atrás do nginx) ────────────────────
STG_BACKEND_PORT=3010
STG_FRONTEND_PORT=8090
